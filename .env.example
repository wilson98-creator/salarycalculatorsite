# Public site URL — used in canonical tags, schema, sitemap
NEXT_PUBLIC_SITE_URL=https://paywise.example.com.au

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA4_ID=

# Plausible (optional, free self-hosted or paid). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# ──────────────────────────────────────────────────────────
# NEWSLETTER (Web3Forms, free, no account needed)
# ──────────────────────────────────────────────────────────
# Get a free access key in 2 minutes:
#   1. Go to https://web3forms.com
#   2. Enter your email (subscribers will be sent here) and click "Get Access Key"
#   3. Check your inbox, copy the key
#   4. Paste it here as NEXT_PUBLIC_NEWSLETTER_KEY
# Until this is set, the form will render but show "Setup required" and not submit.
NEXT_PUBLIC_NEWSLETTER_KEY=
